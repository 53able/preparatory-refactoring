+}
+
+function isRemoteIsland(zip: string): boolean {
+  return zip.startsWith("90") || zip.startsWith("97");
+}
+
+export function shippingFee(order: Order | undefined): number {
+  if (!order) return 0;
+  if (order.items.length === 0) return 0;
+
+  const s = subtotal(order.items);
+  let fee = s >= FREE_SHIPPING_THRESHOLD ? 0 : cfg.baseFee;
+  if (order.express) fee += EXPRESS_SURCHARGE;
+  if (isRemoteIsland(order.zip)) fee += REMOTE_ISLAND_SURCHARGE;
+  if (order.coupon === "FREESHIP") fee = 0;
+  return fee;
